<Window x:Class="BallsServer.App.FirstShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balls Server — First Working Share"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Padding="22"
              Background="#FF111827"
              CornerRadius="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="88"
                  Height="88"
                  Margin="0,0,20,0"
                  Padding="8"
                  Background="White"
                  CornerRadius="20">
            <Image Source="/BallsServer;component/Assets/balls-server-logo.png"
                   Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Foreground="#FF93C5FD"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="BALLS SERVER" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="{Binding PageTitle}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#FFD1D5DB"
                       Text="{Binding PageSubtitle}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Margin="0,18,0,0"
              Padding="22"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <StackPanel Visibility="{Binding HostPanelVisibility}">
            <TextBlock FontSize="19"
                       FontWeight="SemiBold"
                       Text="Choose what this PC will host" />
            <TextBlock Margin="0,5,0,16"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Nothing changes until the preview is complete and you approve a Windows UAC prompt."
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Folder" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Margin="0,0,10,0"
                       AutomationProperties.Name="Folder to host"
                       Text="{Binding HostFolder, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1"
                      AutomationProperties.Name="Choose folder to host"
                      Click="BrowseHostFolderButton_Click"
                      Content="Browse…" />
            </Grid>
            <TextBlock Margin="0,16,0,7"
                       FontWeight="SemiBold"
                       Text="Access path" />
            <StackPanel Orientation="Horizontal">
              <RadioButton Margin="0,0,22,0"
                           AutomationProperties.Name="Private local network"
                           Content="Private LAN"
                           IsChecked="{Binding IsLocalAccessPath}" />
              <RadioButton AutomationProperties.Name="Tailscale network"
                           Content="Tailscale"
                           IsChecked="{Binding IsTailscaleAccessPath}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0"
                       Foreground="#FF8A1C16"
                       Text="{Binding HostValidationMessage}"
                       TextWrapping="Wrap" />
            <Button Margin="0,18,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Preview Host Files setup"
                    Background="{StaticResource AccentBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    Click="PreviewHostSetupButton_Click"
                    Content="Preview setup"
                    Foreground="White" />
            <Border Margin="0,18,0,0"
                    Padding="16"
                    Background="#FFF1F5F9"
                    CornerRadius="10"
                    Visibility="{Binding HostPreviewVisibility}">
              <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="What Balls Server will change" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding HostChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding StringFormat=• {0}}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Apply Host Files setup"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="ApplyHostSetupButton_Click"
                        Content="{Binding HostApplyButtonText}"
                        Foreground="White"
                        IsEnabled="{Binding CanApplyHostSetup}" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,14,0,0"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Host setup progress"
                       FontWeight="SemiBold"
                       Text="{Binding HostSetupMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HostSetupStatusVisibility}" />
            <Border Margin="0,14,0,0"
                    Padding="16"
                    Background="#FFE8F5EC"
                    BorderBrush="#FF75A884"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding GeneratedSetupCodeVisibility}">
              <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Setup code ready" />
                <TextBlock Margin="0,5,0,10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Send this code only to the approved client. It contains the limited credential."
                           TextWrapping="Wrap" />
                <TextBox MinHeight="90"
                         AutomationProperties.Name="Generated Balls Server setup code"
                         IsReadOnly="True"
                         Text="{Binding GeneratedSetupCode, Mode=OneWay}"
                         TextWrapping="Wrap" />
                <Button Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Copy setup code"
                        Click="CopySetupCodeButton_Click"
                        Content="Copy setup code" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Visibility="{Binding ConnectPanelVisibility}">
            <TextBlock FontSize="19"
                       FontWeight="SemiBold"
                       Text="Connecting to Balls Server" />
            <TextBlock Margin="0,5,0,16"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Paste the setup code shown on the host computer. The code is a secret because it contains one limited access grant."
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Setup code" />
            <TextBox MinHeight="116"
                     Margin="0,6,0,0"
                     Padding="10"
                     AcceptsReturn="True"
                     AutomationProperties.Name="Balls Server setup code"
                     Text="{Binding SetupCode, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#FF8A1C16"
                       Text="{Binding ConnectionValidationMessage}"
                       TextWrapping="Wrap" />
            <Button Margin="0,18,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Preview connection"
                    Background="{StaticResource AccentBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    Click="PreviewConnectionButton_Click"
                    Content="Preview connection"
                    Foreground="White" />
            <Border Margin="0,18,0,0"
                    Padding="16"
                    Background="#FFF1F5F9"
                    CornerRadius="10"
                    Visibility="{Binding ConnectionPreviewVisibility}">
              <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Connection preview" />
                <TextBlock Margin="0,7,0,0"
                           FontFamily="Cascadia Mono"
                           Text="{Binding ConnectionEndpoint}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ConnectionCredentialLabel, StringFormat=Limited credential: {0}}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ConnectionChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4,0,0"
                                 Text="{Binding StringFormat=• {0}}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Row="2"
                 Margin="4,14,4,0"
                 Foreground="{StaticResource MutedTextBrush}"
                 Text="Authenticated SMB 3.0+ only. Never expose TCP 445 publicly or enable guest access."
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </Grid>
  </ScrollViewer>
</Window>
